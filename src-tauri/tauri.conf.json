{
  "productName": "MONO.STT",
  "version": "0.1.6",
  "identifier": "local.inkvoice.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MONO.STT",
        "center": true,
        "width": 1000,
        "height": 680,
        "minWidth": 800,
        "minHeight": 540,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#f4f4f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": [
        {
          "identifier": "main-window",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-minimize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-close",
            "core:window:allow-start-dragging"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEMTVCNzkwQUQ0MTYyRDgKUldUWVlrR3RrTGNWallhL2dzd0xaYzhJRitDc0lNUjQvdjZ1VDhrT2JQQW5xQWVpVTR1MjBjZjUK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/Rui333333/MONO.STT/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
