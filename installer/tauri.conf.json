{
  "productName": "MONO.STT 安装程序",
  "identifier": "local.inkvoice.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MONO.STT 安装",
        "width": 365,
        "height": 132,
        "center": true,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#ffffff00",
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'",
      "capabilities": [
        {
          "identifier": "installer",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
